# Google OAuth Client ID
# Lấy tại: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# WebSocket của chat hỗ trợ. Để trống khi chạy local (Vite proxy /ws -> localhost:8080).
# Trên Vercel BẮT BUỘC đặt, vì rewrite của Vercel không chuyển tiếp WebSocket:
# VITE_WS_URL=wss://<backend>.up.railway.app/ws
VITE_WS_URL=
