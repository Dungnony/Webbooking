# ============================================
# Mau file .env cho backend - copy thanh .env roi dien gia tri that.
# KHONG commit file .env. Tren Render/Railway: khai bao cac bien nay trong muc Environment.
# ============================================

# Database - PostgreSQL (Supabase: dung Session Pooler cong 5432, KHONG dung 6543)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Khoa ky token dang nhap, it nhat 32 ky tu. Tao ngau nhien:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Supabase Storage - luu anh (Project Settings -> API Keys -> Secret keys, dang sb_secret_...)
SUPABASE_KEY=
#SUPABASE_URL=https://madpcgneaunzuwvkugtu.supabase.co
#SUPABASE_STORAGE_BUCKET=images

# Webhook Sepay (de trong = moi webhook bi tu choi)
SEPAY_API_KEY=

# Mail - Gmail SMTP (dung App Password, khong phai mat khau Gmail)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Tuy chon
#GOOGLE_CLIENT_ID=
#JPA_DDL_AUTO=validate
